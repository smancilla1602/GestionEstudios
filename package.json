{
  "name": "estudios-medicos",
  "productName": "EstudiosMedicos",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión local de estudios médicos de empleados para Recursos Humanos",
  "author": "Recursos Humanos",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "start": "npm run build && electron .",
    "verify": "electron scripts/verify.js",
    "smoke:ui": "npm run build && electron scripts/smoke-ui.js",
    "seed": "electron scripts/cli.js admin",
    "seed:demo": "electron scripts/cli.js demo",
    "rebuild": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.7",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.empresa.estudiosmedicos",
    "productName": "EstudiosMedicos",
    "copyright": "Copyright © 2026 Recursos Humanos",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Estudios Médicos"
    }
  }
}
